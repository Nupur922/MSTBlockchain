MST_CHAIN_ID=91562037
MST_TESTNET_RPC_URL=https://testnetrpc.mstblockchain.com
MST_TESTNET_CHAIN_ID=91562037
MST_TESTNET_CHAIN_ID_HEX=0x5752035
MST_EXPLORER_URL=https://testnet.mstscan.com

# Live Deployed Contract Addresses on MST Testnet
FARM_REGISTRY_ADDRESS=0xDA6Fe875D30Bd4329415625b845fC7b4Fb859C9b
AGRI_TRUST_VAULT_ADDRESS=0x69AC2F2687D0434e83309bFD62cB5d511E02519b

# Deployer / Admin Private Key (Keep secret! Never commit real keys!)
PRIVATE_KEY=
DEPLOYER_PRIVATE_KEY=
ORACLE_PRIVATE_KEY=

# Optional: Dedicated AI Oracle address or leave empty to default to deployer
AI_ORACLE_ADDRESS=

# ------------------------------------------------------------
# COPERNICUS DATA SPACE — Sentinel Hub
# ------------------------------------------------------------
COPERNICUS_CLIENT_ID=your_copernicus_client_id_here
COPERNICUS_CLIENT_SECRET=your_copernicus_client_secret_here
SENTINEL_HUB_URL=https://sh.dataspace.copernicus.eu/api/v1/statistics
COPERNICUS_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token

# ------------------------------------------------------------
# OPENWEATHERMAP — Rain Telemetry
# ------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweather_api_key_here

# ------------------------------------------------------------
# TWILIO — Live Farmer Voice Calls
# ------------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+10000000000
TWILIO_VERIFIED_TO_NUMBER=+917483799325

# ------------------------------------------------------------
# ULTRAMSG — WhatsApp Notifications
# ------------------------------------------------------------
ULTRAMSG_INSTANCE_ID=your_instance_id_here
ULTRAMSG_TOKEN=your_token_here
