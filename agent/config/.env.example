# ------------------------------------------------------------
# CONTRACT ADDRESSES (filled by Developer 1 after deploy)
# Get from: agent/config/contracts.json after deploy script runs
# Example: npx hardhat run scripts/deploy.js --network localhost
# ------------------------------------------------------------
