# Grant Type: Client Credentials
# ------------------------------------------------------------
COPERNICUS_CLIENT_ID=sh-670aef60-5123-404e-8328-8e189101d40d
COPERNICUS_CLIENT_SECRET=Rr4S0bUDbxNThAKS7CQ2HY5GLDps8Gfy

# Sentinel Hub Statistics API endpoint (do not change)
SENTINEL_HUB_URL=https://sh.dataspace.copernicus.eu/api/v1/statistics

# Copernicus OAuth2 Token endpoint (do not change)
